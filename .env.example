# 실제 값은 .env 에 넣으세요 (.env 는 커밋되지 않음). 이 파일은 예시용입니다.

# GitHub Webhook 서명(HMAC-SHA256) 검증용 시크릿.
# GitHub 저장소 Webhook 설정에 입력한 Secret 과 동일한 값이어야 합니다.
GITHUB_WEBHOOK_SECRET=

# 워크플로우 파일 조회용 토큰. 최소 권한(contents: read)만 권장합니다.
GITHUB_TOKEN=

# GitHub API 주소 (기본값). GitHub Enterprise 사용 시 변경합니다.
GITHUB_API_URL=https://api.github.com
